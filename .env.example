# CORE
SECRET_KEY=change-me-to-a-random-string
ENCRYPTION_KEY_SALT=change-me-to-a-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
APP_URL=http://localhost:8000

# DOCKER / VPS
# Production: set APP_DOMAIN to the public DNS name without a scheme, set
# DEBUG=false, use https:// in APP_URL, and generate a unique database password.
APP_DOMAIN=localhost
POSTGRES_DB=ruang
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ruang

# STORAGE
STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_CUSTOM_DOMAIN=
S3_REGION_NAME=auto

# EMAIL
EMAIL_BACKEND_TYPE=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# GOOGLE AUTH (user login/signup - separate from platform credentials below)
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# PLATFORM CREDENTIALS — set per deployment here (these take precedence), or
# per organization via the Django admin at /admin/ -> Platform credentials.
PLATFORM_FACEBOOK_APP_ID=
PLATFORM_FACEBOOK_APP_SECRET=
PLATFORM_INSTAGRAM_APP_ID=
PLATFORM_INSTAGRAM_APP_SECRET=
# LinkedIn - see README "LinkedIn" section. Choose Path A or Path B (or both).
# Path B (Community Management API) credentials are automatically reused for
# personal connections, giving refresh tokens + inbox.
PLATFORM_LINKEDIN_PERSONAL_CLIENT_ID=
PLATFORM_LINKEDIN_PERSONAL_CLIENT_SECRET=
PLATFORM_LINKEDIN_COMPANY_CLIENT_ID=
PLATFORM_LINKEDIN_COMPANY_CLIENT_SECRET=
# Legacy shared vars (still honored as fallback for both personal + company,
# assumed to be CM-approved). Leave commented unless migrating from an older install.
# PLATFORM_LINKEDIN_CLIENT_ID=
# PLATFORM_LINKEDIN_CLIENT_SECRET=
PLATFORM_TIKTOK_CLIENT_KEY=
PLATFORM_TIKTOK_CLIENT_SECRET=
PLATFORM_GOOGLE_CLIENT_ID=
PLATFORM_GOOGLE_CLIENT_SECRET=
PLATFORM_PINTEREST_APP_ID=
PLATFORM_PINTEREST_APP_SECRET=
# X OAuth 2.0 app (Authorization Code with PKCE)
PLATFORM_X_CLIENT_ID=
PLATFORM_X_CLIENT_SECRET=

# UNSPLASH — optional; enables stock-photo search in the composer.
# Create a free app at https://unsplash.com/developers and paste its Access Key.
UNSPLASH_ACCESS_KEY=

# INBOUND WEBHOOKS
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_LOGIN_WEBHOOK_VERIFY_TOKEN=
YOUTUBE_WEBHOOK_SECRET=

# INTELLIGENCE — optional hosted SaaS integration.
# All five vars must be set for the Intelligence menu item / billing flow
# to appear. Leave any blank to keep Studio in vanilla OSS mode (no Stripe,
# no left-nav Intelligence entry, no /orgs/<id>/intelligence/ URLs).
# - INTELLIGENCE_INTERNAL_URL: hosted Intelligence's /internal/v1/ base
# - INTELLIGENCE_PUBLIC_URL:   hosted Intelligence's /v1/ base
# - STUDIO_DEPLOYMENT_ID:      must match the value registered on the
#                              Intelligence side via register_studio_deployment
# - STUDIO_SHARED_SECRET:      HMAC secret for this deployment (Intelligence-issued)
# - STUDIO_BASE_URL:           https:// URL of THIS Studio deployment.
#                              Validated at boot — non-https raises
#                              ImproperlyConfigured.
INTELLIGENCE_INTERNAL_URL=
INTELLIGENCE_PUBLIC_URL=
STUDIO_DEPLOYMENT_ID=
STUDIO_SHARED_SECRET=
STUDIO_BASE_URL=

# MCP OAUTH — optional. The /api/v1/mcp endpoint accepts a native OAuth login
# (e.g. Claude Desktop → "Add custom connector") in addition to bb_studio_ API
# keys. Both URLs default to APP_URL; set them only for a split app/api
# deployment. In production they must be the public https origin Claude reaches.
# MCP_PUBLIC_BASE_URL=https://your-studio.example.com
# MCP_OAUTH_ISSUER_URL=https://your-studio.example.com


# RUANG AI AUTOMATION
# Ordered fallback: openai, anthropic, gemini, openai_compatible, demo.
# Remove demo in production if generation must fail closed.
RUANG_AI_PROVIDERS=demo
RUANG_OPENAI_API_KEY=
RUANG_OPENAI_BASE_URL=https://api.openai.com/v1
RUANG_OPENAI_MODEL=gpt-5.4-mini
RUANG_ANTHROPIC_API_KEY=
RUANG_ANTHROPIC_MODEL=claude-sonnet-5
RUANG_GEMINI_API_KEY=
RUANG_GEMINI_MODEL=gemini-3.6-flash
RUANG_COMPATIBLE_API_KEY=
RUANG_COMPATIBLE_BASE_URL=
RUANG_COMPATIBLE_MODEL=
RUANG_AI_MONTHLY_TOKEN_LIMIT=1000000
RUANG_AI_MONTHLY_COST_LIMIT_USD=50.00
# USD per 1M tokens, maintained by the operator as pricing changes.
RUANG_AI_COSTS_JSON={}

# Vendor-neutral image/video generation webhook.
RUANG_MEDIA_WEBHOOK_URL=
RUANG_MEDIA_WEBHOOK_TOKEN=

# LEGAL / PRIVACY / AGPL
# Replace every placeholder before production. The source revision must be the
# exact output of: git rev-parse HEAD
RUANG_LEGAL_ENTITY_NAME=Set the operator legal entity
RUANG_LEGAL_ENTITY_ADDRESS=Set the operator registered address
RUANG_LEGAL_COUNTRY=Indonesia
RUANG_SUPPORT_EMAIL=support@yourdomain.com
RUANG_PRIVACY_EMAIL=privacy@yourdomain.com
RUANG_TERMS_VERSION=2026-07-31
RUANG_PRIVACY_VERSION=2026-07-31
RUANG_LEGAL_EFFECTIVE_DATE=31 Juli 2026
RUANG_TERMS_URL=https://yourdomain.com/legal/terms/
RUANG_PRIVACY_URL=https://yourdomain.com/legal/privacy/
RUANG_SOURCE_CODE_URL=https://github.com/unknownymouse/ruang
RUANG_SOURCE_CODE_REVISION=replace-with-git-commit
# Optional for GitLab, archives, or other hosts; must contain the exact revision.
# RUANG_DEPLOYED_SOURCE_URL=https://source-host.example/project/tree/replace-with-git-commit
# Generate once with: openssl rand -hex 32. Keep stable across SECRET_KEY rotations.
RUANG_PRIVACY_AUDIT_KEY=replace-with-a-separate-stable-random-secret
# JSON array. Required when external AI/media/Intelligence processing is enabled.
# Example: [{"name":"Provider","purpose":"AI generation","privacy_url":"https://provider.example/privacy","location":"Country/region"}]
RUANG_SUBPROCESSORS_JSON=[]
RUANG_ACCOUNT_RECORD_RETENTION_DAYS=1825
RUANG_SECURITY_LOG_RETENTION_DAYS=180
RUANG_BACKUP_RETENTION_DAYS=30
